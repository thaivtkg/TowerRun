[gd_resource type="Resource" script_class="AbilityData" format=3]

[ext_resource type="Script" path="res://data/abilities/effect_data.gd" id="1_eff"]
[ext_resource type="Script" path="res://data/abilities/damage_effect_data.gd" id="2_dmg"]
[ext_resource type="Script" path="res://data/abilities/heal_effect_data.gd" id="3_heal"]
[ext_resource type="Script" path="res://data/abilities/ability_data.gd" id="4_ab"]

[sub_resource type="Resource" id="Resource_dmg"]
script = ExtResource("2_dmg")
base_damage = 120.0
damage_type = 1
scalings = {
"TOTAL_AP": 1.2
}

[sub_resource type="Resource" id="Resource_heal"]
script = ExtResource("3_heal")
heal_amount = 80.0
apply_to_self = true
scalings = {
"TOTAL_AP": 0.5
}

[resource]
script = ExtResource("4_ab")
id = "slime_dark_flood"
name = "Đại Hồng Thủy Hắc Ám"
ability_type = 2
target_rule = 10
aoe_shape = 1
aoe_radius = 1
cooldown = 8.0
energy_cost = 100.0
narrative_template = "Slime Chúa Tể triệu hồi một cơn sóng bùn độc hắc ám dội thẳng xuống {action_target}, gây {0} sát thương phép lên tất cả nạn nhân trúng đòn. Đồng thời, chất dinh dưỡng hút được giúp Boss Hồi Phục ngay lập tức {1} Máu cho bản thân."
caveat = "Kỹ năng tạo chấn động rung chuyển màn hình khi va chạm mặt đất."
progression_ranks = {
"Hồi phục": [80, 140, 220],
"Sát thương sóng thần": [120, 200, 320],
"Tỉ lệ SMPT": ["120%", "150%", "180%"]
}
effects = Array[ExtResource("1_eff")]([SubResource("Resource_dmg"), SubResource("Resource_heal")])
