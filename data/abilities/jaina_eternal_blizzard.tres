[resource]
script = ExtResource("3_ab")
id = "jaina_eternal_blizzard"
name = "Bão Tuyết Vĩnh Cửu"
ability_type = 2
target_rule = 10
aoe_shape = 1
aoe_radius = 1
cooldown = 0.0
energy_cost = 100.0
narrative_template = "{hero} giáng một cơn bão băng tuyết lạnh giá xuống {action_target} trong bán kính 1 ô, gây {0} và khiến tốc độ đánh của các nạn nhân bị [b]Làm Chậm[/b] 35% trong 3.5 giây."
caveat = "Kẻ địch đã chịu trạng thái Đóng Băng từ trước sẽ phải chịu thêm 20% sát thương từ kỹ năng này."
progression_ranks = {
"Sát thương": [140, 220, 320],
"Tỉ lệ Làm Chậm": ["35%", "45%", "55%"],
"Tỉ lệ SMPT": ["70%", "85%", "100%"]
}
effects = Array[ExtResource("1_eff")]([SubResource("Resource_dmg")])
