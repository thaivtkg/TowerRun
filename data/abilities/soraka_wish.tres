[resource]
script = ExtResource("3_ab")
id = "soraka_wish"
name = "Nguyện Ước Cứu Rỗi"
ability_type = 2
target_rule = 7
cooldown = 0.0
energy_cost = 100.0
narrative_template = "{hero} cầu nguyện ánh sáng tinh tú bao bọc {action_target}, lập tức [b]Hồi Phục[/b] {0} Máu cho tất cả các mục tiêu. Những đồng minh đang dưới 40% máu nhận thêm 50% lượng máu hồi phục."
caveat = "Các đồng minh đang chịu trạng thái Vết Thương Sâu sẽ chỉ nhận 50% lượng hồi phục từ kỹ năng này."
progression_ranks = {
"Hồi máu": [80, 130, 190],
"Tỉ lệ SMPT": ["50%", "65%", "80%"]
}
effects = Array[ExtResource("1_eff")]([SubResource("Resource_heal")])
