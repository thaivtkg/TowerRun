[gd_resource type="Resource" script_class="AbilityData" format=3]

[ext_resource type="Script" path="res://data/abilities/effect_data.gd" id="1_eff"]
[ext_resource type="Script" path="res://data/abilities/damage_effect_data.gd" id="2_dmg"]
[ext_resource type="Script" path="res://data/abilities/ability_data.gd" id="3_ab"]

[sub_resource type="Resource" id="Resource_dmg"]
script = ExtResource("2_dmg")
base_damage = 25.0
damage_type = 1
scalings = {
"TOTAL_AP": 0.5
}

[resource]
script = ExtResource("3_ab")
id = "jaina_basic_attack"
name = "Tia Băng Hàn Giá"
cooldown = 0.65
target_rule = 1
narrative_template = "{hero} phóng một mảnh băng sắc nhọn từ pháp trượng vào {action_target}, gây {0} sát thương phép và tích tụ 10 Năng Lượng."
caveat = "Đòn đánh chuyển hóa 100% thành sát thương phép thuật."
effects = Array[ExtResource("1_eff")]([SubResource("Resource_dmg")])
